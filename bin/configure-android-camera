#!/usr/bin/env python3
"""Declare Android camera access for the Tauri WebView media permission flow."""

from pathlib import Path
import sys
import xml.etree.ElementTree as ET


manifest = (
    Path(__file__).resolve().parents[1]
    / "app/bankiva-app/src-tauri/gen/android/app/src/main/AndroidManifest.xml"
)
if not manifest.is_file():
    sys.exit(f"Android-Manifest fehlt: {manifest}; zuerst tauri android init ausführen.")

ET.register_namespace("android", "http://schemas.android.com/apk/res/android")
android = "{http://schemas.android.com/apk/res/android}"
tree = ET.parse(manifest)
root = tree.getroot()
permission = "android.permission.CAMERA"

if not any(
    element.tag == "uses-permission" and element.get(f"{android}name") == permission
    for element in root
):
    ET.SubElement(root, "uses-permission", {f"{android}name": permission})
    tree.write(manifest, encoding="utf-8", xml_declaration=True)

print(f"Kameraberechtigung konfiguriert: {manifest}")
